[Unit]
Description=GOX Chat Dev web service
After=network.target

[Service]
Type=simple
User=gox
Group=gox
WorkingDirectory=/opt/gox
Environment=GOX_HOST=127.0.0.1
Environment=GOX_PORT=8080
Environment=GOX_DATA_DIR=/var/lib/gox/chat-dev
ExecStart=/usr/bin/python3 /opt/gox/chat_dev/app.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gox/chat-dev

[Install]
WantedBy=multi-user.target
