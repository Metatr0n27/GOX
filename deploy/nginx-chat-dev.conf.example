# Example only. Keep the Python service on 127.0.0.1; expose it only through TLS + auth.
server {
    listen 443 ssl http2;
    server_name chat.example.com;

    # Configure certificates with your normal ACME/certbot process.
    ssl_certificate /etc/letsencrypt/live/chat.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chat.example.com/privkey.pem;

    auth_basic "GOX Chat Dev";
    auth_basic_user_file /etc/nginx/gox-chat-dev.htpasswd;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
        client_max_body_size 1m;
    }
}
